name: CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
jobs:
  windows-build-test:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: msys2/setup-msys2@v2
        with:
          msystem: UCRT64
          update: true
          install: >-
            mingw-w64-ucrt-x86_64-gcc
            mingw-w64-ucrt-x86_64-cmake
            mingw-w64-ucrt-x86_64-ninja
            mingw-w64-ucrt-x86_64-libzip
      - name: Locate native toolchain
        id: toolchain
        shell: msys2 {0}
        run: echo "root=$(cygpath -w /ucrt64)" >> "$GITHUB_OUTPUT"
      - name: Native Windows build, CTest and portable ZIP
        shell: pwsh
        env:
          UCRT_ROOT: ${{ steps.toolchain.outputs.root }}
        run: |
          ./scripts/build-windows.ps1 -ToolchainRoot $env:UCRT_ROOT -Action Package
      - uses: actions/upload-artifact@v4
        with:
          name: windows-portable
          path: dist/*.zip
  linux-compatibility:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: sudo apt-get update && sudo apt-get install -y build-essential libzip-dev pkg-config
      - run: make all
      # Memory errors / leaks: MinGW has no AddressSanitizer, so this job is the
      # sanitizer gate for the engine (keep it even though Windows is the main target).
      - name: AddressSanitizer + UndefinedBehaviorSanitizer
        run: |
          make clean
          make all CFLAGS="-std=c11 -g -O1 -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -Wall -Wextra" \
                   LDFLAGS="-fsanitize=address,undefined" LDLIBS="-lzip -fsanitize=address,undefined"
          for f in sample/corpus/*.hwpx; do ./build/hp append "$f" /tmp/a.hwpx --text x; ./build/hp open /tmp/a.hwpx > /dev/null; done
