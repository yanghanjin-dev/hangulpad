/* Windows file properties (Details tab) for HangulPad.exe / hp.exe */
#include <winver.h>
#include "hp/version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     HP_VERSION_MAJOR, HP_VERSION_MINOR, HP_VERSION_PATCH, 0
PRODUCTVERSION  HP_VERSION_MAJOR, HP_VERSION_MINOR, HP_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "HangulPad project"
            VALUE "FileDescription", "HangulPad - lightweight Korean word processor (HWPX)"
            VALUE "FileVersion", HP_VERSION_STRING
            VALUE "InternalName", "HangulPad"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
            VALUE "ProductName", "HangulPad"
            VALUE "ProductVersion", HP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
