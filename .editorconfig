# Sources contain Korean string literals: keep them UTF-8 (no BOM) on Windows editors too.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{c,h}]
indent_style = space
indent_size = 4

[*.ps1]
# Windows PowerShell 5.1 reads BOM-less scripts as ANSI: keep .ps1 files ASCII-only.
charset = utf-8
