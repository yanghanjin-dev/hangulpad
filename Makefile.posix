# HangulPad engine (C11) — Phase 0–1
CC ?= gcc
CFLAGS ?= -std=c11 -Wall -Wextra -Wpedantic -O2
CPPFLAGS += -Iinclude
LDFLAGS +=
LDLIBS += $(shell pkg-config --libs libzip 2>/dev/null || echo -lzip) -lz
PREFIX ?= /usr/local
# Version comes from include/hp/version.h (single source of truth).
VERSION := $(shell sed -n 's/^#define HP_VERSION_STRING "\(.*\)"/\1/p' include/hp/version.h)

LIB_SRCS := src/common.c src/ir.c src/xml.c src/hwpx_package.c src/hwpx_read.c src/hwpx_write.c src/edit.c src/hwp.c src/cfb.c src/aes128.c
LIB_OBJS := $(LIB_SRCS:src/%.c=build/%.o)

.PHONY: fuzz golden-check golden-update irdump version all clean test cli check release release-windows release-windows-portable release-source install uninstall dist

all: cli test

version:
	@echo $(VERSION)

build:
	mkdir -p build build/win

dist:
	mkdir -p dist

# Source tree zip for download (git HEAD → dist/hangulpad-source.zip)
release-source: dist/hangulpad-source.zip
dist/hangulpad-source.zip: | dist
	git archive --format=zip --prefix=hangulpad/ -o dist/hangulpad-source.zip HEAD
	@cp -f dist/hangulpad-source.zip "dist/한글패드-소스코드.zip"
	@echo "source: $$(pwd)/dist/hangulpad-source.zip"
	@ls -la dist/hangulpad-source.zip "dist/한글패드-소스코드.zip"

build/%.o: src/%.c src/hwpx_package.h src/xml.h src/cfb.h src/aes128.h $(wildcard include/hp/*.h) | build
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build/cli.o: src/cli.c | build
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build/test_roundtrip.o: tests/test_roundtrip.c | build
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

cli: build/hp
build/hp: build/cli.o $(LIB_OBJS)
	$(CC) $(LDFLAGS) $^ -o $@ $(LDLIBS)

# Stripped release binary under dist/
release: dist/hp
dist/hp: build/hp | dist
	cp -f build/hp dist/hp
	strip dist/hp
	@echo "executable: $$(pwd)/dist/hp (v$(VERSION))"
	@file dist/hp
	@ls -la dist/hp

# Cross-compile Windows x86_64 console EXE (needs mingw + deps in WIN_PREFIX).
# Default: /tmp/win-prefix with static libzip + zlib (see scripts/build-win-deps.sh).
WIN_CC ?= x86_64-w64-mingw32-gcc
WIN_PREFIX ?= /tmp/win-prefix
WIN_CFLAGS ?= -std=c11 -Wall -Wextra -O2 -Iinclude -I$(WIN_PREFIX)/include
WIN_LIBS ?= $(WIN_PREFIX)/lib/libzip.a $(WIN_PREFIX)/lib/libz.a -lbcrypt -lshell32

release-windows: dist/hp.exe
dist/hp.exe: $(LIB_SRCS) src/cli.c | dist build
	@command -v $(WIN_CC) >/dev/null || { echo "missing $(WIN_CC); install gcc-mingw-w64-x86-64"; exit 1; }
	@test -f $(WIN_PREFIX)/lib/libzip.a || { echo "missing $(WIN_PREFIX)/lib/libzip.a — run scripts/build-win-deps.sh first"; exit 1; }
	$(WIN_CC) $(WIN_CFLAGS) -c src/common.c -o build/win/common.o
	$(WIN_CC) $(WIN_CFLAGS) -c src/ir.c -o build/win/ir.o
	$(WIN_CC) $(WIN_CFLAGS) -c src/hwpx_read.c -o build/win/hwpx_read.o
	$(WIN_CC) $(WIN_CFLAGS) -c src/hwpx_write.c -o build/win/hwpx_write.o
	$(WIN_CC) $(WIN_CFLAGS) -c src/hwp.c -o build/win/hwp.o
	$(WIN_CC) $(WIN_CFLAGS) -c src/hwpx_package.c -o build/win/hwpx_package.o
	$(WIN_CC) $(WIN_CFLAGS) -c src/xml.c -o build/win/xml.o
	$(WIN_CC) $(WIN_CFLAGS) -c src/cli.c -o build/win/cli.o
	$(WIN_CC) -static -o dist/hp.exe build/win/common.o build/win/ir.o build/win/hwpx_read.o build/win/hwpx_write.o build/win/hwp.o build/win/hwpx_package.o build/win/xml.o build/win/cli.o $(WIN_LIBS)
	x86_64-w64-mingw32-strip dist/hp.exe
	@echo "executable: $$(pwd)/dist/hp.exe"
	@file dist/hp.exe
	@ls -la dist/hp.exe

# Portable Windows zip: hp.exe + zlib1.dll + libzip.dll (+ MinGW runtime DLLs)
release-windows-portable:
	./scripts/package-windows-portable.sh

install: dist/hp
	install -d $(DESTDIR)$(PREFIX)/bin
	install -m 755 dist/hp $(DESTDIR)$(PREFIX)/bin/hp

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/hp

test: build/test_hwp build/test_roundtrip build/test_xml build/irdump build/test_line_layout build/test_page_flow build/test_pagination build/test_table_pagination
	./build/test_table_pagination
	./build/test_page_flow
	./build/test_line_layout
	mkdir -p tmp
	./build/test_pagination
	./build/test_xml
	./build/test_roundtrip
	./build/test_hwp .
	@$(MAKE) --no-print-directory golden-check

# Reader regression guard: the full IR of every sample must match tests/golden/.
# After an intended reader change: make golden-update, then review `git diff tests/golden`.
GOLDEN_INPUTS := $(wildcard sample/corpus/*.hwpx) $(wildcard tests/fixtures/*.hwpx)
GOLDEN_HWP := $(wildcard sample/corpus/*.hwp)
golden-check: build/irdump
	@fail=0; for f in $(GOLDEN_INPUTS); do n=$$(basename "$$f" .hwpx); \
	  if ! ./build/irdump "$$f" | cmp -s - "tests/golden/$$n.txt"; then echo "GOLDEN MISMATCH: $$n"; fail=1; fi; done; \
	  for f in $(GOLDEN_HWP); do n=hwp-$$(basename "$$f" .hwp); \
	  if ! ./build/irdump "$$f" | cmp -s - "tests/golden/$$n.txt"; then echo "GOLDEN MISMATCH: $$n"; fail=1; fi; done; \
	  if [ $$fail = 0 ]; then echo "golden IR matches ($(words $(GOLDEN_INPUTS) $(GOLDEN_HWP)) files)"; else exit 1; fi
golden-update: build/irdump
	@for f in $(GOLDEN_INPUTS); do n=$$(basename "$$f" .hwpx); ./build/irdump "$$f" > "tests/golden/$$n.txt"; done; \
	  for f in $(GOLDEN_HWP); do n=hwp-$$(basename "$$f" .hwp); ./build/irdump "$$f" > "tests/golden/$$n.txt"; done; echo "tests/golden updated"

build/test_line_layout: tests/test_line_layout.c src/line_layout.h include/hp/ir.h | build
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/test_line_layout.c -o $@

build/test_page_flow: tests/test_page_flow.c src/pagination.h | build
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/test_page_flow.c -o $@

build/test_table_pagination: tests/test_table_pagination.c src/table_pagination.h include/hp/ir.h | build
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/test_table_pagination.c -o $@

build/test_pagination: tests/test_pagination.c $(LIB_OBJS)
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/test_pagination.c $(LIB_OBJS) -o $@ $(LDLIBS)

build/test_xml: tests/test_xml.c src/xml.c src/xml.h build/common.o | build
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/test_xml.c src/xml.c build/common.o -o $@

# Fuzzers (clang + libFuzzer): make fuzz; build/fuzz_xml DIR; build/fuzz_reader DIR; build/fuzz_hwp DIR (seed: small .hwp files)
FUZZ_CC ?= clang
FUZZ_FLAGS ?= -g -O1 -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined
fuzz: | build
	$(FUZZ_CC) $(FUZZ_FLAGS) $(CPPFLAGS) -Isrc tests/fuzz/fuzz_xml.c src/xml.c src/common.c -o build/fuzz_xml
	$(FUZZ_CC) $(FUZZ_FLAGS) $(CPPFLAGS) -Isrc tests/fuzz/fuzz_reader.c $(LIB_SRCS) -o build/fuzz_reader $(LDLIBS)
	$(FUZZ_CC) $(FUZZ_FLAGS) $(CPPFLAGS) -Isrc tests/fuzz/fuzz_hwp.c $(LIB_SRCS) -o build/fuzz_hwp $(LDLIBS)
	$(FUZZ_CC) $(FUZZ_FLAGS) $(CPPFLAGS) -DHP_FUZZING -Isrc tests/fuzz/fuzz_hwp_records.c $(LIB_SRCS) -o build/fuzz_hwp_records $(LDLIBS)

# Dump the full IR of an HWPX file (regression checks): build/irdump file.hwpx
irdump: build/irdump
build/irdump: tests/irdump.c $(LIB_OBJS)
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/irdump.c $(LIB_OBJS) -o $@ $(LDLIBS)

build/test_hwp: tests/test_hwp.c $(LIB_OBJS)
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/test_hwp.c $(LIB_OBJS) -o $@ $(LDLIBS)

build/test_roundtrip: build/test_roundtrip.o $(LIB_OBJS)
	$(CC) $(LDFLAGS) $^ -o $@ $(LDLIBS)

check: test

clean:
	rm -rf build dist

# Regenerate the checked-in HWPX fixture (optional).
fixture: build/hp
	./build/hp new tests/fixtures/simple_paragraph.hwpx --text "한글패드" --title simple_paragraph

