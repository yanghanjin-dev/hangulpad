# Binary samples must never get line-ending conversion.
*.hwpx binary
*.hwp  binary
*.pdf  binary
*.jpg  binary
*.png  binary
# Golden IR dumps are compared byte-for-byte (LF on every OS).
tests/golden/*.txt text eol=lf
# Shell/Make files break with CRLF; keep LF everywhere.
*.sh   text eol=lf
Makefile* text eol=lf
*.c    text eol=lf
*.h    text eol=lf
